{
  "name": "template-vite-ts",
  "description": "A Phaser 3 TypeScript template using Vite.",
  "version": "1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaserjs/template-vite-ts.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/phaserjs/template-vite-ts/issues"
  },
  "homepage": "https://github.com/phaserjs/template-vite-ts#readme",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.mjs",
    "dev:client": "vite --config vite/config.dev.mjs",
    "dev-nolog": "npm run dev",
    "dev-full": "npm run dev",
    "build": "vite build --config vite/config.prod.mjs",
    "build-nolog": "npm run build",
    "start": "node server/index.mjs",
    "test": "node --test server/integration.test.mjs",
    "migrate:json-to-mongo": "node scripts/migrate-json-to-mongodb.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.24.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "phaser": "4.0.0",
    "terser": "^5.39.0",
    "ws": "^8.21.3"
  }
}

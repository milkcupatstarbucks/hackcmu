# Auth0 — Single Page Application settings.
# Copy this file and fill in the values:  cp .env.example .env.local
# (.env.local is gitignored, so your filled-in copy stays local.)

# Dashboard > Applications > your SPA app > Settings.
# Format: your-tenant.us.auth0.com
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Optional today, required once a game server verifies player identity.
# Set to the Identifier of an API you registered under Dashboard > APIs.
# Without it Auth0 returns an *opaque* access token a server cannot verify;
# with it you get a signed JWT the server can validate via Auth0's public keys.
VITE_AUTH0_AUDIENCE=
